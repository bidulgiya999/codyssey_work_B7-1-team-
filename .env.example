# 세션 쿠키 서명 키 (필수, 16자 이상)
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# DB 연결 주소 (기본값: sqlite:///./app.db)
DATABASE_URL=sqlite:///./app.db

# 네이버 API (B) — 네이버 클라우드 플랫폼 NAVER API HUB Application의 키(뉴스 검색·검색어 트렌드 API를 켜 둘 것)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_TIMEOUT_SECONDS=5

# LLM API (C)
LLM_API_KEY=
LLM_BASE_URL=https://copa.codyssey.kr/v1
LLM_MODEL=gpt-5-mini
LLM_TIMEOUT_SECONDS=50

# 새 릴스 서비스 (app.reels_main:app)
CHAT_TOTAL_TIMEOUT_SECONDS=55
KNOWLEDGE_USAGE_SCOPE=educational_noncommercial
# HTTPS 운영 시 true. 로컬 HTTP 개발에서는 false.
SESSION_HTTPS_ONLY=false
# 로컬 API 확인용. 운영에서는 false 권장.
ENABLE_API_DOCS=false
