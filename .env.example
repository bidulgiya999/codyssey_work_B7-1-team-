# 복사 후 SECRET_KEY와 LLM_API_KEY를 로컬에서 설정하세요.
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///./app.db

# 코디세이 교육과정에서 받은 API 키. 기존 프로젝트의 주소·모델이므로 계정 안내 확인
LLM_API_KEY=
LLM_BASE_URL=https://copa.codyssey.kr/v1
LLM_MODEL=gpt-5-mini
LLM_TIMEOUT_SECONDS=50
LLM_MAX_COMPLETION_TOKENS=8000
# 프록시 지원을 확인한 경우에만 true
LLM_JSON_MODE=false
CHAT_TOTAL_TIMEOUT_SECONDS=60

# 자료 사용 범위: commercial이면 NC 카드 제외
KNOWLEDGE_USAGE_SCOPE=educational_noncommercial
# 운영 HTTPS에서는 true, 로컬 HTTP에서는 false
SESSION_HTTPS_ONLY=false
ENABLE_API_DOCS=false
