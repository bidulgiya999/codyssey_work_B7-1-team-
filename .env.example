# 복사 후 SECRET_KEY와 GROQ_API_KEY를 로컬에서 설정하세요.
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///./app.db

# Groq Console: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_COMPLETION_TOKENS=6000
CHAT_TOTAL_TIMEOUT_SECONDS=40

# 자료 사용 범위: commercial이면 NC 카드 제외
KNOWLEDGE_USAGE_SCOPE=educational_noncommercial
# 운영 HTTPS에서는 true, 로컬 HTTP에서는 false
SESSION_HTTPS_ONLY=false
ENABLE_API_DOCS=false
